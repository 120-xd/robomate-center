{
  "id":"LH-岩爪","name":"RoboMate-LH-岩爪","type":"humanoid",
  "description":"四足爬行机器人，四条腿各有上下两个180度舵机，可前进、后退和转向。",
  "hardware":{"chip":"ATmega328P","protocol":"stk500v1","baudRate":115200,"communication":"串口115200，每条命令以换行结束","components":[
    {"name":"左前上/右前上/左后上/右后上舵机","pin":"D2/D3/D4/D5","type":"servo"},
    {"name":"左前下/右前下/左后下/右后下舵机","pin":"D6/D7/D8/D9","type":"servo"},
    {"name":"超声波传感器","pin":"D10/D11","type":"ultrasonic"}]},
  "commands":[
    {"cmd":"START","params":null,"desc":"启动超声波自动爬行","method":"startAuto","label":"启动爬行"},
    {"cmd":"FW","params":"1~20","desc":"前进N步","method":"forward","label":"前进","unit":"步"},
    {"cmd":"BW","params":"1~20","desc":"后退N步","method":"backward","label":"后退","unit":"步"},
    {"cmd":"LT","params":"1~20","desc":"向左转N步","method":"turnLeft","label":"左转","unit":"步"},
    {"cmd":"RT","params":"1~20","desc":"向右转N步","method":"turnRight","label":"右转","unit":"步"},
    {"cmd":"HOME","params":null,"desc":"八个舵机回到90度待机姿态","method":"goHome","label":"归位"},
    {"cmd":"STOP","params":null,"desc":"立即停止动作并归位","method":"goHome","label":"停止"},
    {"cmd":"DIST","params":null,"desc":"读取前方超声波距离（厘米）","method":"readDistance","label":"测距"}],
  "commandFormat":"{CMD} {N}","commandValidation":"^(FW|BW|LT|RT)(\\s+\\d{1,2})?$|^(START|HOME|STOP|DIST)$",
  "firmware":"firmware/LH-岩爪/robot_cmd.hex",
  "semanticRules":{"defaultSteps":1,"severalSteps":3,"maxSteps":20,"shortcuts":{"前进":["FW {n}"],"后退":["BW {n}"],"左转":["LT {n}"],"右转":["RT {n}"],"停止":["STOP"],"归位":["HOME"],"测距离":["DIST"],"爬行":["FW {n}"]}},
  "promptExtras":"上电默认使用超声波自动爬行；START可重新启动，STOP/HOME停止。手动移动命令会退出自动模式。代码片段只是动作说明，实际执行通过串口发送命令；不要假设它有夹爪或额外传感器。"
}
