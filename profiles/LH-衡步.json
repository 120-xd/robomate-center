{
  "id": "LH-衡步",
  "name": "RoboMate-LH-衡步",
  "type": "humanoid",
  "description": "四舵机双足机器人，可走路、转弯、太空步、蜂鸣",
  "hardware": {
    "chip": "ATmega328P",
    "protocol": "stk500v1",
    "baudRate": 115200,
    "communication": "串口 115200 baud，每条指令以换行符结束",
    "components": [
      {
        "name": "左腿",
        "pin": "D2",
        "type": "servo"
      },
      {
        "name": "右腿",
        "pin": "D3",
        "type": "servo"
      },
      {
        "name": "左脚",
        "pin": "D4",
        "type": "servo"
      },
      {
        "name": "右脚",
        "pin": "D5",
        "type": "servo"
      },
      {
        "name": "超声波传感器",
        "pin": "D8/D9",
        "type": "ultrasonic"
      },
      {
        "name": "蜂鸣器",
        "pin": "D13",
        "type": "buzzer"
      }
    ]
  },
  "commands": [
    {
      "cmd": "FW",
      "params": "1~20",
      "desc": "前进 N 步",
      "method": "forward",
      "label": "前进",
      "unit": "步"
    },
    {
      "cmd": "BW",
      "params": "1~20",
      "desc": "后退 N 步",
      "method": "backward",
      "label": "后退",
      "unit": "步"
    },
    {
      "cmd": "LT",
      "params": "1~20",
      "desc": "左转 N 步",
      "method": "turnLeft",
      "label": "左转",
      "unit": "步"
    },
    {
      "cmd": "RT",
      "params": "1~20",
      "desc": "右转 N 步",
      "method": "turnRight",
      "label": "右转",
      "unit": "步"
    },
    {
      "cmd": "MW",
      "params": null,
      "desc": "太空步",
      "method": "moonwalk",
      "label": "太空步"
    },
    {
      "cmd": "HOME",
      "params": null,
      "desc": "归中/停止",
      "method": "goHome",
      "label": "归中"
    },
    {
      "cmd": "STOP",
      "params": null,
      "desc": "停止",
      "method": "goHome",
      "label": "停止"
    },
    {
      "cmd": "BEEP",
      "params": null,
      "desc": "蜂鸣器响一声",
      "method": "beep",
      "label": "蜂鸣"
    }
  ],
  "commandFormat": "{CMD} {N}",
  "commandValidation": "^(FW|BW|LT|RT)(\\s+\\d{1,2})?$|^(MW|HOME|STOP|BEEP)$",
  "firmware": "firmware/LH-衡步/robot_cmd.hex",
  "semanticRules": {
    "defaultSteps": 1,
    "severalSteps": 3,
    "maxSteps": 20,
    "shortcuts": {
      "前进": [
        "FW {n}"
      ],
      "后退": [
        "BW {n}"
      ],
      "左转": [
        "LT {n}"
      ],
      "右转": [
        "RT {n}"
      ],
      "转一圈": [
        "RT 4"
      ],
      "转个圈": [
        "RT 4"
      ],
      "旋转": [
        "RT 4"
      ],
      "停下": [
        "HOME"
      ],
      "站住": [
        "HOME"
      ],
      "归位": [
        "HOME"
      ],
      "回去": [
        "HOME"
      ],
      "停": [
        "HOME"
      ],
      "扭屁股": [
        "LT 1",
        "RT 1",
        "LT 1",
        "RT 1"
      ],
      "摇摆": [
        "LT 1",
        "RT 1",
        "LT 1",
        "RT 1"
      ],
      "晃晃": [
        "LT 1",
        "RT 1",
        "LT 1",
        "RT 1"
      ],
      "跳舞": [
        "MW"
      ],
      "跳个舞": [
        "MW"
      ],
      "太空步": [
        "MW"
      ],
      "月球漫步": [
        "MW"
      ],
      "蜂鸣": [
        "BEEP"
      ],
      "叫一声": [
        "BEEP"
      ],
      "滴滴": [
        "BEEP"
      ]
    }
  },
  "promptExtras": "LH10 是衡步双足机器人，有 4 个 180° 舵机控制双腿和双脚，可以像人一样走路、转弯，还能做出太空步。遇到障碍时会发出蜂鸣声提醒。"
}