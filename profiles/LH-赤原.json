{
  "id": "LH-赤原",
  "name": "RoboMate-LH-赤原",
  "type": "vehicle",
  "description": "六舵机六轮摇臂越野车，可翻越障碍、爬坡",
  "hardware": {
    "chip": "ATmega328P",
    "protocol": "stk500v1",
    "baudRate": 115200,
    "communication": "串口 115200 baud，每条指令以换行符结束",
    "components": [
      {
        "name": "左前轮",
        "pin": "D2",
        "type": "servo_360"
      },
      {
        "name": "右前轮",
        "pin": "D3",
        "type": "servo_360"
      },
      {
        "name": "左中轮",
        "pin": "D4",
        "type": "servo_360"
      },
      {
        "name": "右中轮",
        "pin": "D5",
        "type": "servo_360"
      },
      {
        "name": "左后轮",
        "pin": "D6",
        "type": "servo_360"
      },
      {
        "name": "右后轮",
        "pin": "D7",
        "type": "servo_360"
      },
      {
        "name": "超声波传感器",
        "pin": "D8/D9",
        "type": "ultrasonic"
      }
    ]
  },
  "commands": [
    {
      "cmd": "FW",
      "params": "1~20",
      "desc": "前进 N 步",
      "method": "forward",
      "label": "前进",
      "unit": "步"
    },
    {
      "cmd": "BW",
      "params": "1~20",
      "desc": "后退 N 步",
      "method": "backward",
      "label": "后退",
      "unit": "步"
    },
    {
      "cmd": "LT",
      "params": "1~20",
      "desc": "左转 N 步",
      "method": "turnLeft",
      "label": "左转",
      "unit": "步"
    },
    {
      "cmd": "RT",
      "params": "1~20",
      "desc": "右转 N 步",
      "method": "turnRight",
      "label": "右转",
      "unit": "步"
    },
    {
      "cmd": "HOME",
      "params": null,
      "desc": "归中/停止",
      "method": "goHome",
      "label": "归中"
    },
    {
      "cmd": "STOP",
      "params": null,
      "desc": "停止",
      "method": "goHome",
      "label": "停止"
    }
  ],
  "commandFormat": "{CMD} {N}",
  "commandValidation": "^(FW|BW|LT|RT)(\\s+\\d{1,2})?$|^(HOME|STOP)$",
  "firmware": "firmware/LH-赤原/robot_cmd.hex",
  "semanticRules": {
    "defaultSteps": 1,
    "severalSteps": 3,
    "maxSteps": 20,
    "shortcuts": {
      "前进": [
        "FW {n}"
      ],
      "后退": [
        "BW {n}"
      ],
      "左转": [
        "LT {n}"
      ],
      "右转": [
        "RT {n}"
      ],
      "转一圈": [
        "RT 4"
      ],
      "转个圈": [
        "RT 4"
      ],
      "旋转": [
        "RT 4"
      ],
      "停下": [
        "HOME"
      ],
      "站住": [
        "HOME"
      ],
      "归位": [
        "HOME"
      ],
      "回去": [
        "HOME"
      ],
      "停": [
        "HOME"
      ]
    }
  },
  "promptExtras": "LH11 是赤原六轮越野机器人，采用摇臂悬挂设计，6 个 360° 舵机驱动 6 个轮子，像火星车一样能翻越障碍物和爬坡。"
}